<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Video2BIC.Core</RootNamespace>
    <AssemblyName>Video2BIC.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    La deteccion de contenedores y el seguimiento ya estaban resueltos en
    MaritimeVision.Core (YOLO sobre ONNX Runtime y ByteTrack). Video2BIC los
    reutiliza y aporta lo que no existia: localizacion de rotulos, OCR e
    interpretacion de la ISO 6346.
  -->
  <ItemGroup>
    <ProjectReference Include="../../../MaritimeVision/src/MaritimeVision.Core/MaritimeVision.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(OnnxRuntimeVersion)" />
    <PackageReference Include="OpenCvSharp4" Version="$(OpenCvSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Video2BIC.Tests" />
  </ItemGroup>

</Project>
