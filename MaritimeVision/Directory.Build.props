<Project>

  <PropertyGroup>
    <!--
      net10.0 (LTS, soporte hasta noviembre de 2028). El repositorio nacio como
      net5.0, que dejo de tener soporte en mayo de 2022 y para el que ni
      OpenCvSharp4 ni Microsoft.ML.OnnxRuntime publican ya assets.

      Los dos paquetes nativos se consumen por su asset de netstandard2.0, que
      net10.0 carga sin cambios: la actualizacion no obliga a tocar codigo.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <OpenCvSharpVersion>4.10.0.20241108</OpenCvSharpVersion>
    <OnnxRuntimeVersion>1.20.1</OnnxRuntimeVersion>
  </PropertyGroup>

</Project>
