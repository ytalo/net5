{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MaritimeVision": {
    "ModelPath": "models/containers.onnx",
    "LabelsPath": "labels/maritime-container.names",
    "TargetClasses": "",
